{
  "name": "sei-study-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run apps/server",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "db:backup": "tsx apps/server/src/backup.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
